# Salin menjadi .env lalu isi nilainya.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database: Supabase (PostgreSQL) — https://supabase.com ----
# Supabase > Project > tombol "Connect" > pilih "Session pooler" > salin URI, ganti [YOUR-PASSWORD].
# Contoh: postgresql://postgres.abcdefghijkl:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Jika dikosongkan saat development, server memakai database in-memory (data hilang saat restart).
DATABASE_URL=

# ---- Supabase Storage untuk foto achievement (opsional tapi disarankan) ----
# Supabase > Project Settings > API: "Project URL" dan kunci "service_role" (RAHASIA, jangan taruh di frontend!)
# Jika kosong, foto disimpan sebagai data URL di database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=achievements

# ---- Keamanan ----
# Isi dengan string acak panjang, contoh hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Domain frontend yang boleh mengakses API (pisahkan koma). Kosong = semua domain.
CORS_ORIGIN=http://localhost:3000

# ---- Akun admin pertama (dibuat otomatis jika belum ada admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Isi program & achievement contoh saat database masih kosong (true/false)
SEED_SAMPLE_DATA=true

# ---- Notifikasi Telegram ke admin (opsional) ----
# Token dari @BotFather; chat id dari https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
