# Salin menjadi .env lalu isi nilainya.

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas gratis: https://www.mongodb.com/cloud/atlas) ----
# Contoh: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/bimbel-wanda?retryWrites=true&w=majority
# Jika dikosongkan saat development, server memakai database in-memory (data hilang saat restart).
MONGODB_URI=

# ---- Keamanan ----
# Isi dengan string acak panjang, contoh hasil: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Domain frontend yang boleh mengakses API (pisahkan koma). Kosong = semua domain.
CORS_ORIGIN=http://localhost:3000

# ---- Akun admin pertama (dibuat otomatis jika belum ada admin) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Isi program & achievement contoh saat database masih kosong (true/false)
SEED_SAMPLE_DATA=true

# ---- Notifikasi Telegram ke admin (opsional) ----
# Token dari @BotFather; chat id dari https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
